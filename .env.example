# .env.example - Шаблон конфигурации проекта Hasap Pro
# Скопируйте этот файл в .env и заполните своими данными

# Database Settings
DB_HOST=localhost
DB_NAME=erp_db
DB_USER=postgres
DB_PASSWORD=your_db_password_here
DB_PORT=5432

# Django Settings
# Генерация ключа: python -c 'from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())'
DJANGO_SECRET_KEY=your_secret_key_here
DJANGO_DEBUG=False
PROJECT_DOMAIN=localhost

# Redis
REDIS_URL=redis://127.0.0.1:6379/1

# Celery (worker/beat — фоновые задачи, см. accounting/tasks.py). Внутри
# docker-compose используйте имя сервиса ("redis"), не localhost.
CELERY_BROKER_URL=redis://redis:6379/2
CELERY_RESULT_BACKEND=redis://redis:6379/3

# Tenant (test1) Superuser
COMPANY_SCHEME=test1
DJANGO_SUPERUSER_USERNAME=test1
DJANGO_SUPERUSER_EMAIL=test1@example.com
DJANGO_SUPERUSER_PASSWORD=your_superuser_password

# Global SaaS Admin
DJANGO_SAAS_SUPERUSER_LOGIN=admin
DJANGO_SAAS_SUPERUSER_PASSWORD=admin_password
DJANGO_SAAS_SUPERUSER_EMAIL=admin@example.com